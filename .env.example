DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"

# Sans SMTP, les emails sont écrits dans ./outbox/ (utile en démo)
# SMTP_HOST=smtp.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Creneau <no-reply@mondomaine.fr>"

# Protège GET /api/cron/reminders (rappels J-1). À déclencher chaque heure
# (workflow GitHub Actions fourni : .github/workflows/reminders.yml).
# CRON_SECRET="une-longue-chaine-aleatoire"

# Image Docker / Railway : DATABASE_URL="file:/data/dev.db" (disque persistant monté sur /data).
# SEED_DEMO=1 au premier boot seulement -> recrée le compte de démo et /b/demo-cabinet.
# Le conteneur écoute sur $PORT (défaut 3000), injecté par Railway.
